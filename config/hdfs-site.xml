<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- hdfs-site.xml: HDFS replication and storage paths -->
<configuration>
    <!-- Replication factor: 1 (single-node local storage protection) -->
    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>
    <!-- NameNode storage (master only) -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///hadoop/dfs/name</value>
    </property>
    <!-- DataNode storage (slaves only) -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///hadoop/dfs/data</value>
    </property>
    <!-- Web UI binding -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>master:9870</value>
    </property>
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>
    <!-- Prevent NameNode from getting stuck in SafeMode during distributed job runs -->
    <property>
        <name>dfs.safemode.threshold.pct</name>
        <value>0.0</value>
    </property>
    <property>
        <name>dfs.safemode.extension</name>
        <value>0</value>
    </property>
</configuration>
